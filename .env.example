# ─────────────────────────────────────────────────────────────────────────────
# Kopieer dit bestand naar .env en vul je eigen keys in.
# .env wordt NOOIT gecommit (staat in .gitignore) — je keys zijn veilig.
# ─────────────────────────────────────────────────────────────────────────────

# Mapy.com API key — gratis registratie op https://developer.mapy.com/
# Nodig voor mini-kaartjes (Static Images API)
MAPY_API_KEY=your_mapy_api_key_here

# DeepL API key — gratis Free-tier op https://www.deepl.com/pro-api
# 500.000 gratis tekens/maand — ruim genoeg voor dit project
# Free-tier keys eindigen op ":fx"  (bv. "abc123:fx")
DEEPL_API_KEY=your_deepl_api_key_here

# (Optioneel) Vertalingstaal — standaard "EN-GB"
# Andere opties: "NL", "FR", "DE"
TRANSLATE_TARGET_LANG=EN-GB

# (Optioneel) Max foto's per POI — standaard 4
MAX_PHOTOS_PER_POI=4

# (Optioneel) Buffer-straal in km rond de GPX — standaard 1
BUFFER_KM=1

# (Optioneel) Maximale breedte van gedownloade foto's in pixels — standaard 800
PHOTO_MAX_WIDTH=800
